# Own backend/.env is ignored. Restart backend after changing these.
# Mock mode works with no key or model; never use real personal scenarios.
MODEL_MODE=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Verified documented prior model: nvidia/nemotron-3.5-lightning:free
# No automatic or paid fallback; set that identifier explicitly for live checks.
LIVE_CALL_LIMIT=50
MOCK_BEHAVIOR=success
